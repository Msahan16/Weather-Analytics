# Server Configuration
PORT=5000
NODE_ENV=development

# OpenWeatherMap API Key
# Sign up at https://openweathermap.org/api to get your free key
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Cache TTL (in seconds) - 5 minutes default
CACHE_TTL_RAW=300
CACHE_TTL_PROCESSED=300

# Auth0 Configuration (Optional for local development / Required for production)
# Set AUTH_REQUIRED=false to allow testing without Auth0 tenant setup
AUTH_REQUIRED=false
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com/
AUTH0_AUDIENCE=https://weather-analytics-api.local

# MySQL Database Configuration (XAMPP Default)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Weather-AnalyticsDB
